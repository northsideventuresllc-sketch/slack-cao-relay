# /etc/systemd/system/cao-relay-muse.service
# Slack CAO Loop relay — Muse CAO. One of four separate services (PLAN-v7 D6):
# shared code, separate process, separate service user, separate keys, queue and journal.
#
# Keys (D7): ExecStartPre runs /usr/local/bin/cao-relay-fetch-keys muse as root on EVERY
# start; it fetches fresh from the Secure Vault into tmpfs /run/credentials/cao-relay-muse/
# (dir 0500, files 0400, owner cao-relay-muse) and the process reads them from there
# (CAO_RELAY_KEY_DIR). Files:
#   slack-app-token  (Socket Mode app-level token)
#   slack-bot-token  (bot token)
#   brain-key        (Muse only: cao-relay-muse brain key — the other three programs reach the brain through the Muse program's broker)
# No key value ever appears in this file.

[Unit]
Description=Slack CAO Loop relay — Muse CAO
Documentation=file:///opt/cao-relay/docs/RELAY-RUNBOOK.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=cao-relay-muse
Group=cao-relay-muse
SupplementaryGroups=cao-relay-admin cao-relay-claude cao-relay-gemini cao-relay-axon-hermes
EnvironmentFile=/etc/cao-relay/relay.env
Environment=CAO_RELAY_CAO=muse
Environment=CAO_RELAY_KEY_DIR=/run/credentials/cao-relay-muse
Environment=CAO_RELAY_STATE_DIR=/var/lib/cao-relay/muse
Environment=CAO_RELAY_RUN_DIR=/run/cao-relay
Environment=CAO_RELAY_HOLDER=vm
# Each program reads back close-out logs from its own vault checkout (git fetch, read-only use).
Environment=CAO_RELAY_VAULT_DIR=/var/lib/cao-relay/muse/vault
ExecStartPre=+/usr/local/bin/cao-relay-fetch-keys muse
ExecStart=/usr/bin/node /opt/cao-relay/dist/index.js run
ExecStopPost=+/usr/local/bin/cao-relay-fetch-keys --wipe muse
# Fail-closed: brain down / lease held elsewhere → exit 1 → retried every 30 s.
# Exit 78 = stay down (revoked token, Socket Mode reconnects exhausted, config placeholders) → alert, no restart.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=78

StateDirectory=cao-relay/muse
StateDirectoryMode=0700
# /run/cao-relay/<cao> (control socket) and /run/cao-relay/broker come from
# /etc/tmpfiles.d/cao-relay.conf so the broker and admin groups can reach them.
UMask=0077

# Isolation envelope (D6): MemoryMax=128M, CPUQuota=25%. The program's own watchdog
# alerts and exits on >50% CPU sustained 5 minutes.
MemoryMax=128M
CPUQuota=25%

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/cao-relay/muse /run/cao-relay
ReadOnlyPaths=/opt/cao-relay /etc/cao-relay/relay.env

[Install]
WantedBy=multi-user.target
