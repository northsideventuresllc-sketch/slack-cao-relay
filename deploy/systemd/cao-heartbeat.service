# /etc/systemd/system/cao-heartbeat.service
# The cron `cao-heartbeat` (PLAN-v7 D4): writes Muse CAO's cao_heartbeat row
# (agent MUSE) with the cao-relay-muse brain key. Fired every 15 minutes by
# cao-heartbeat.timer.
[Unit]
Description=Slack CAO Loop — Muse CAO heartbeat (cao_heartbeat)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cao-relay-muse
Group=cao-relay-muse
EnvironmentFile=/etc/cao-relay/relay.env
Environment=CAO_RELAY_KEY_DIR=/run/credentials/cao-heartbeat
ExecStartPre=+/usr/local/bin/cao-relay-fetch-keys heartbeat
ExecStart=/usr/bin/node /opt/cao-relay/dist/index.js heartbeat
ExecStopPost=+/usr/local/bin/cao-relay-fetch-keys --wipe heartbeat
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/cao-relay /etc/cao-relay/relay.env
MemoryMax=128M
